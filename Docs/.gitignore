# ----------------------------------
# MariaDB (CRITICAL: Never track live DB files)
# ----------------------------------
config/mariadb/

# ----------------------------------
# BookStack Noise (Properly nested exclusions)
# ----------------------------------

# 1. Ignore everything in the bookstack config folder...
config/bookstack/*

# 2. ...but explicitly allow Git to step into the 'www' folder.
!config/bookstack/www/

# 3. Now ignore everything inside the 'www' folder...
config/bookstack/www/*

# 4. ...but explicitly allow the 'uploads' folder and all its contents!
!config/bookstack/www/uploads/

# (Optional: If you have a storage folder next to uploads, un-ignore it here too)
!config/bookstack/www/storage/

# ----------------------------------
# Environment & Overrides
# ----------------------------------
.env
docker-compose.override.yml

# ----------------------------------
# Logs & OS Files
# ----------------------------------
*.log
.DS_Store
Thumbs.db
